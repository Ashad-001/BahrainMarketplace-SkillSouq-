# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Environment variables / Secrets (CRITICAL)
.env
.env.local
*.env

# dependencies
/node_modules/
/venv/
__pycache__/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/
/dist/

# misc
.DS_Store
Thumbs.db
*.pem

# System & Editor files
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
